# Database Connection
# Choose ONE of the following options:

# Option 1: Local PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/gansytems

# Option 2: Neon Cloud PostgreSQL
PRO_DATABASE_URL=postgresql://neondb_owner:REPLACE_ME@REPLACE_ME.neon.tech/neondb?sslmode=require&channel_binding=require

# MQTT broker URL (HiveMQ Cloud or self-hosted Mosquitto)
MQTT_BROKER_URL=mqtts://REPLACE_ME.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# Comma-separated list of allowed browser origins for WebSocket upgrades.
# Same-origin requests are always allowed when this is empty.
ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# Food Safety Passport Configuration
# ===========================================

# Signing secret for passport certificates (REQUIRED for production)
# Generate a secure random string: openssl rand -hex 32
# WARNING: Changing this invalidates all existing certificate signatures
# Store securely and backup - loss prevents verification of existing certificates
PASSPORT_SIGNING_SECRET=

# Public URL for passport verification page (optional, used for QR codes)
# Example: https://your-domain.com
# If not set, QR codes will not be generated
PASSPORT_PUBLIC_URL=

NODE_ENV="development"
